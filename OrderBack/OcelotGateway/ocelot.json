      "DownstreamPathTemplate": "/neworders",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5247
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/neworders/{ip}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
